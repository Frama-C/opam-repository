synopsis: "Frama-C typestates plug-in"
description:
  "This Frama-C plug-in is used to specify and prove typestates properties"
maintainer: "https://git.frama-c.com/frama-c"
authors: "Sebastien Patte"
license: "LGPL-2.1-only"
homepage: "https://frama-c.com/fc-plugins/typestates.html"
bug-reports: "https://git.frama-c.com/pub/typestates/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.13" & != "3.13.0"}
  "frama-c" {>= "34.0~" & < "35.0~"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
